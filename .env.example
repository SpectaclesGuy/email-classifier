# Environment variables for Email Classification and Priority Scoring
# Example:
# MODEL_PATH=models/artifacts/email_classifier.joblib
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_api_key
# GMAIL_CLIENT_SECRET_PATH=secrets/gmail_client_secret.json
# GMAIL_TOKEN_PATH=secrets/gmail_token.json
# GMAIL_POLL_INTERVAL_MINUTES=30
# GMAIL_QUERY=in:inbox
# GMAIL_USER_ID=me
# SQLITE_DB_PATH=data/processed/emails.db
# TRANSFORMER_BASE_MODEL=distilbert-base-uncased
# TRANSFORMER_MODEL_DIR=models/artifacts/distilbert
# TRANSFORMER_CHECKPOINT_PATH=models/artifacts/distilbert/checkpoints/epoch_3.pt
# TRANSFORMER_MAX_LENGTH=256

